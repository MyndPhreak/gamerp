@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Collections.Generic;
@using System.Linq;

@namespace GameRP.UI
@inherits PanelComponent

<root style="@RootStyle">
    @if (_isOpen)
    {
        <!-- Flash overlay -->
        @if (_showFlash)
        {
            <div style="position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-color: white; opacity: @_flashOpacity; z-index: 200; pointer-events: none;"></div>
        }

        <!-- License card centered on screen -->
        <div style="position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 700px; pointer-events: all; z-index: 150;">

            <!-- License card -->
            <div style="background: linear-gradient(135deg, #f5f5dc 0%, #e8e4d0 100%); border-radius: 16px; border: 3px solid #8b7d6b; padding: 0; overflow: hidden; box-shadow: 0 8px 32px rgba(0,0,0,0.5); display: flex; flex-direction: column;">

                <!-- Header bar -->
                <div style="background: linear-gradient(135deg, #1a3a5c 0%, #0d2137 100%); padding: 12px 24px; display: flex; flex-direction: row; justify-content: space-between; align-items: center;">
                    <div style="font-size: 10px; font-weight: 600; color: rgba(255,255,255,0.6); text-transform: uppercase; letter-spacing: 2px;">DEPARTMENT OF MOTOR VEHICLES</div>
                    <div style="font-size: 16px; font-weight: 800; color: white; text-transform: uppercase; letter-spacing: 3px;">Driver License</div>
                </div>

                <!-- Card body -->
                <div style="display: flex; flex-direction: row; padding: 20px 24px; gap: 24px;">

                    <!-- Left: Photo area -->
                    <div style="flex-shrink: 0; width: 180px;">
                        <div style="width: 180px; height: 220px; background-color: #d4cfc0; border: 2px solid #8b7d6b; border-radius: 4px; overflow: hidden;">
                            <panel @ref="_photoPanel" style="width: 100%; height: 100%; background-size: cover; background-position: center;">
                                @if (_faceTexture == null)
                                {
                                    <div style="font-size: 12px; color: #8b7d6b; text-align: center; padding-top: 90px;">Photo<br/>Preview</div>
                                }
                            </panel>
                        </div>
                    </div>

                    <!-- Right: Form fields -->
                    <div style="flex-grow: 1; display: flex; flex-direction: column; gap: 14px;">

                        <!-- Full Name -->
                        <div style="flex-direction: column;">
                            <div style="font-size: 10px; font-weight: 700; color: #8b7d6b; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 4px;">Full Name</div>
                            <TextEntry @ref="_nameEntry" placeholder="Enter your name..."
                                   MaxLength="@(100)"
                                   style="width: 100%; padding: 10px 12px; border-radius: 6px; border: 2px solid #c4b99a; background-color: rgba(255,255,255,0.8); font-size: 16px; font-weight: 600; color: #2c2c2c;" />
                            @if (!string.IsNullOrEmpty(_nameError))
                            {
                                <div style="font-size: 11px; color: #d32f2f; font-weight: 500; margin-top: 2px;">@_nameError</div>
                            }
                        </div>

                        <!-- Date of Birth -->
                        <div style="flex-direction: column;">
                            <div style="font-size: 10px; font-weight: 700; color: #8b7d6b; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 4px;">Date of Birth</div>
                            <div style="display: flex; flex-direction: row; gap: 8px;">
                                <!-- Month stepper -->
                                <div style="display: flex; flex-direction: row; align-items: center; flex-grow: 2; border-radius: 6px; border: 2px solid #c4b99a; background-color: rgba(255,255,255,0.8); overflow: hidden;">
                                    <div style="padding: 8px 10px; cursor: pointer; font-size: 16px; color: #8b7d6b; font-weight: 700;" @onclick="@DecrementMonth">‹</div>
                                    <div style="flex-grow: 1; text-align: center; font-size: 13px; color: #2c2c2c; font-weight: 600;">@(_dobMonth == 0 ? "Month" : new DateTime(2000, _dobMonth, 1).ToString("MMM"))</div>
                                    <div style="padding: 8px 10px; cursor: pointer; font-size: 16px; color: #8b7d6b; font-weight: 700;" @onclick="@IncrementMonth">›</div>
                                </div>
                                <!-- Day stepper -->
                                <div style="display: flex; flex-direction: row; align-items: center; flex-grow: 1; border-radius: 6px; border: 2px solid #c4b99a; background-color: rgba(255,255,255,0.8); overflow: hidden;">
                                    <div style="padding: 8px 8px; cursor: pointer; font-size: 16px; color: #8b7d6b; font-weight: 700;" @onclick="@DecrementDay">‹</div>
                                    <div style="flex-grow: 1; text-align: center; font-size: 13px; color: #2c2c2c; font-weight: 600;">@(_dobDay == 0 ? "Day" : _dobDay.ToString())</div>
                                    <div style="padding: 8px 8px; cursor: pointer; font-size: 16px; color: #8b7d6b; font-weight: 700;" @onclick="@IncrementDay">›</div>
                                </div>
                                <!-- Year stepper -->
                                <div style="display: flex; flex-direction: row; align-items: center; flex-grow: 2; border-radius: 6px; border: 2px solid #c4b99a; background-color: rgba(255,255,255,0.8); overflow: hidden;">
                                    <div style="padding: 8px 8px; cursor: pointer; font-size: 16px; color: #8b7d6b; font-weight: 700;" @onclick="@DecrementYear">‹</div>
                                    <div style="flex-grow: 1; text-align: center; font-size: 13px; color: #2c2c2c; font-weight: 600;">@(_dobYear == 0 ? "Year" : _dobYear.ToString())</div>
                                    <div style="padding: 8px 8px; cursor: pointer; font-size: 16px; color: #8b7d6b; font-weight: 700;" @onclick="@IncrementYear">›</div>
                                </div>
                            </div>
                        </div>

                        <!-- Gender -->
                        <div style="flex-direction: column;">
                            <div style="font-size: 10px; font-weight: 700; color: #8b7d6b; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 4px;">Gender</div>
                            <div style="display: flex; flex-direction: row; gap: 8px;">
                                @foreach (var g in _genderOptions)
                                {
                                    var isActive = g == _gender;
                                    var gStyle = isActive
                                        ? "flex-grow: 1; padding: 8px; border-radius: 6px; cursor: pointer; font-size: 13px; font-weight: 600; color: white; background-color: #1a3a5c; text-align: center;"
                                        : "flex-grow: 1; padding: 8px; border-radius: 6px; cursor: pointer; font-size: 13px; font-weight: 500; color: #2c2c2c; background-color: rgba(255,255,255,0.5); border: 2px solid #c4b99a; text-align: center;";
                                    <div style="@gStyle" @onclick="@(() => { _gender = g; StateHasChanged(); })">@g</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Footer with buttons -->
                <div style="padding: 16px 24px; border-top: 2px solid #c4b99a; display: flex; flex-direction: row; gap: 12px; justify-content: flex-end;">
                    <div style="padding: 12px 28px; border-radius: 8px; cursor: pointer; font-size: 14px; font-weight: 700; color: #8b7d6b; background-color: transparent; border: 2px solid #c4b99a; text-align: center;" @onclick="@OnBackClicked">Back</div>
                    <div style="padding: 12px 28px; border-radius: 8px; cursor: pointer; font-size: 14px; font-weight: 700; color: white; background: linear-gradient(135deg, #1a3a5c 0%, #0d2137 100%); text-align: center; pointer-events: @(_isValid ? "all" : "none"); opacity: @(_isValid ? 1f : 0.5f);" @onclick="@OnPrintClicked">
                        @(_isValid ? "Print License" : $"Invalid ({_name.Length}, {_dobMonth}, {_dobDay}, {_dobYear})")
                    </div>
                </div>
            </div>
        </div>
    }
</root>

@code
{
    private bool _isOpen;
    private bool _showFlash;
    private float _flashOpacity = 0f;
    private RPPlayer _rpPlayer;

    // Form fields
    private string _name = "";
    private string _nameError = "";
    private TextEntry _nameEntry;
    private int _dobMonth = 0;
    private int _dobDay = 0;
    private int _dobYear = 0;
    private string _gender = "Male";

    private readonly string[] _genderOptions = new[] { "Male", "Female", "Other" };

    // Face camera texture (placeholder for SceneCamera render target)
    private Texture _faceTexture;
    private Panel _photoPanel;

    // Camera component for face photo
    private CameraComponent _faceCamera;
    private GameObject _faceCameraObject;

    // Callbacks
    public Action OnBack { get; set; }
    public Action<string, string, string> OnPrintLicense { get; set; }

    private bool _isValid => _name.Length >= 2 && _dobMonth > 0 && _dobDay > 0 && _dobYear > 0;

    private int DaysInSelectedMonth =>
        _dobMonth >= 1 && _dobMonth <= 12 && _dobYear >= 1940
            ? DateTime.DaysInMonth( _dobYear, _dobMonth )
            : 31;

    private string RootStyle => "position: absolute; left: 0; top: 0; width: 100%; height: 100%; z-index: 100; pointer-events: none;";

    public void Open( RPPlayer rpPlayer, string prefilledGender )
    {
        if ( _isOpen ) return;

        _rpPlayer = rpPlayer;
        _isOpen = true;
        _showFlash = false;
        _flashOpacity = 0f;
        _gender = prefilledGender;
        _name = "";
        _nameError = "";
        if ( _nameEntry != null ) _nameEntry.Text = "";
        _dobMonth = 0;
        _dobDay = 0;
        _dobYear = 0;

        SetupFaceCamera();

        StateHasChanged();
    }

    private void SetupFaceCamera()
    {
        if ( _rpPlayer == null ) return;

        // Find the player's body renderer to position the camera at head height
        var bodyRenderer = _rpPlayer.Components.GetInChildren<SkinnedModelRenderer>();
        if ( bodyRenderer == null ) return;

        var headPos = _rpPlayer.GameObject.WorldPosition + Vector3.Up * 64f;
        var camPos = headPos + _rpPlayer.GameObject.WorldRotation.Left * 40f;

        // Create a render target texture for the face camera
        _faceTexture = Texture.CreateRenderTarget()
            .WithSize( 360, 440 )
            .Create();

        // Create a temporary GameObject with a CameraComponent for rendering the face
        _faceCameraObject = new GameObject( false, "FaceCamera" );
        _faceCameraObject.WorldPosition = camPos;
        _faceCameraObject.WorldRotation = Rotation.LookAt( headPos - camPos );

        _faceCamera = _faceCameraObject.Components.Create<CameraComponent>( false );
        _faceCamera.FieldOfView = 30f;
        _faceCamera.ZNear = 1f;
        _faceCamera.ZFar = 500f;

        _faceCameraObject.Enabled = true;
        _faceCamera.Enabled = true;
    }


    private void IncrementMonth() { _dobMonth = _dobMonth >= 12 ? 1 : _dobMonth + 1; ClampDay(); StateHasChanged(); }
    private void DecrementMonth() { _dobMonth = _dobMonth <= 1 ? 12 : _dobMonth - 1; ClampDay(); StateHasChanged(); }
    private void IncrementDay() { _dobDay = _dobDay >= DaysInSelectedMonth ? 1 : _dobDay + 1; StateHasChanged(); }
    private void DecrementDay() { _dobDay = _dobDay <= 1 ? DaysInSelectedMonth : _dobDay - 1; StateHasChanged(); }
    private void IncrementYear() { _dobYear = _dobYear >= 2008 ? 1940 : (_dobYear == 0 ? 1990 : _dobYear + 1); ClampDay(); StateHasChanged(); }
    private void DecrementYear() { _dobYear = _dobYear <= 1940 ? 2008 : (_dobYear == 0 ? 1990 : _dobYear - 1); ClampDay(); StateHasChanged(); }

    private void ClampDay()
    {
        if ( _dobDay > DaysInSelectedMonth )
            _dobDay = DaysInSelectedMonth;
    }

    private void OnBackClicked()
    {
        _isOpen = false;
        CleanupFaceCamera();
        OnBack?.Invoke();
        StateHasChanged();
    }

    private async void OnPrintClicked()
    {
        if ( !_isValid ) return;

        try
        {
            var dob = $"{_dobMonth:D2}/{_dobDay:D2}/{_dobYear}";

            // Play flash effect
            _showFlash = true;
            _flashOpacity = 1f;
            StateHasChanged();

            await Task.Delay( 200 );
            _flashOpacity = 0.7f;
            StateHasChanged();

            await Task.Delay( 300 );
            _flashOpacity = 0.3f;
            StateHasChanged();

            await Task.Delay( 300 );
            _flashOpacity = 0f;
            _showFlash = false;
            StateHasChanged();

            await Task.Delay( 700 );

            // Invoke callback with form data
            OnPrintLicense?.Invoke( _name, dob, _gender );

            _isOpen = false;
            StateHasChanged();
        }
        catch ( Exception ex )
        {
            Log.Error( $"[LicenseScreen] OnPrintClicked failed: {ex}" );
        }
        finally
        {
            CleanupFaceCamera();
        }
    }

    private void CleanupFaceCamera()
    {
        _faceCamera = null;
        _faceCameraObject?.Destroy();
        _faceCameraObject = null;
        _faceTexture?.Dispose();
        _faceTexture = null;
        if ( _photoPanel != null )
            _photoPanel.Style.BackgroundImage = null;
    }

    protected override void OnPreRender()
    {
        if ( !_isOpen ) return;

        if ( _nameEntry != null )
        {
            var currentName = _nameEntry.Text ?? "";
            if ( _name != currentName )
            {
                _name = currentName;
                _nameError = _name.Length > 0 && _name.Length < 2 ? "Name must be at least 2 characters" : "";
                StateHasChanged();
            }
        }

        if ( _faceCamera == null || _faceTexture == null ) return;

        // Update face camera position to track player head
        if ( _rpPlayer != null && _faceCameraObject != null )
        {
            var headPos = _rpPlayer.GameObject.WorldPosition + Vector3.Up * 64f;
            var camPos = headPos + _rpPlayer.GameObject.WorldRotation.Left * 40f;
            _faceCameraObject.WorldPosition = camPos;
            _faceCameraObject.WorldRotation = Rotation.LookAt( headPos - camPos );
        }

        // Render face camera to texture
        _faceCamera.RenderToTexture( _faceTexture );

        // Update panel background with rendered texture
        if ( _photoPanel != null && _faceTexture != null )
        {
            _photoPanel.Style.BackgroundImage = _faceTexture;
        }
    }

    public void Close()
    {
        if ( !_isOpen ) return;
        _isOpen = false;
        CleanupFaceCamera();
        StateHasChanged();
    }

    protected override int BuildHash() => System.HashCode.Combine(
        _isOpen, _name, _dobMonth, _dobDay, _dobYear, _gender, _showFlash
    );
}
