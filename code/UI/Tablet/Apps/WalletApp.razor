@using Sandbox.UI.Common;
@using Sandbox.UI.Tablet;
@using Sandbox.UI;
@using System;
@using System.Linq;

<root>
    <div class="wallet-top">
        <label class="balance-label">Cash on Hand</label>
        <label class="balance-value">$@Player?.Money.ToString("N0")</label>
    </div>

    <div class="wallet-info">
        <label class="section-title">Wallet Information</label>
        <div class="info-list">
            <div class="info-row">
                <label class="info-label">Job</label>
                <label class="info-value">@(Player?.JobTitle ?? "Unemployed")</label>
            </div>
            <div class="info-row">
                <label class="info-label">Steam ID</label>
                <label class="info-value">@Game.SteamId</label>
            </div>
        </div>
    </div>
</root>

@code
{
    private RPPlayer Player => Scene.GetAll<RPPlayer>().FirstOrDefault();

    protected override int BuildHash() => System.HashCode.Combine(Player?.Money);
}
