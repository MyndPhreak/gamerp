@using Sandbox;
@using Sandbox.UI;
@using GameRP.Inventory;
@using System;
@using System.Linq;

@namespace GameRP.UI
@inherits Panel

<root class="slot @(IsHovered ? "hovered" : "") @(IsSelected ? "selected" : "")"
      @onclick=@OnLeftClick
      @onrightclick=@OnRightClick
      onmouseover=@(() => IsHovered = true)
      onmouseout=@(() => IsHovered = false)>

    @if (Slot != null && !Slot.IsEmpty)
    {
        var item = Slot.Item;
        var def = item.GetDefinition();
        if (def != null)
        {
            var rarityHex = def.Rarity.GetHex();

            <div class="rarity-frame" style="border-color: @rarityHex;"></div>
            <icon class="item-icon" style="color: @rarityHex;">@def.Icon</icon>

            @if (item.Quantity > 1)
            {
                <label class="quantity">@item.Quantity</label>
            }

            @if (def.IsDamageable)
            {
                var dur = item.GetCurrentDurability();
                var max = def.MaxDurability;
                var pct = max > 0 ? (float)dur / max : 1f;
                var barColor = pct > 0.5f ? "#4ade80" : (pct > 0.25f ? "#fbbf24" : "#ef4444");
                <div class="durability-bar">
                    <div class="durability-fill" style="width: @((int)(pct * 100))%; background-color: @barColor;"></div>
                </div>
            }
        }
    }
</root>

<style>
    ItemSlotPanel {
        width: 56px;
        height: 56px;
        background-color: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 4px;
        cursor: pointer;
        position: relative;
        align-items: center;
        justify-content: center;

        &:hover {
            background-color: rgba(255,255,255,0.1);
            border-color: rgba(255,255,255,0.25);
        }

        &.selected {
            border: 2px solid #fbbf24;
            background-color: rgba(251,191,36,0.1);
        }

        .rarity-frame {
            position: absolute;
            left: 0; top: 0;
            width: 100%;
            height: 100%;
            border-radius: 4px;
            border: 1px solid transparent;
            pointer-events: none;
        }

        .item-icon {
            font-family: 'Material Icons';
            font-size: 32px;
            text-shadow: 0 1px 2px rgba(0,0,0,0.8);
        }

        .quantity {
            position: absolute;
            right: 4px;
            bottom: 2px;
            font-size: 13px;
            font-weight: 800;
            color: white;
            text-shadow: 1px 1px 2px black;
            pointer-events: none;
        }

        .durability-bar {
            position: absolute;
            left: 4px;
            right: 4px;
            bottom: 4px;
            height: 3px;
            background-color: rgba(0,0,0,0.5);
            border-radius: 2px;
        }

        .durability-fill {
            height: 100%;
            border-radius: 2px;
        }
    }
</style>

@code
{
    [Property] public ItemContainer Container { get; set; }
    [Property] public int SlotIndex { get; set; }
    [Property] public bool IsSelected { get; set; }
    [Property] public Action<ItemContainer, int, bool> OnSlotClicked { get; set; }

    public bool IsHovered { get; private set; }

    public ItemSlot Slot => Container?.GetSlot( SlotIndex );

    void OnLeftClick()
    {
        OnSlotClicked?.Invoke( Container, SlotIndex, false );
    }

    void OnRightClick()
    {
        OnSlotClicked?.Invoke( Container, SlotIndex, true );
    }

    public override void Tick()
    {
        base.Tick();
    }

    protected override int BuildHash()
    {
        var item = Slot?.Item;
        return HashCode.Combine(
            item?.ItemId,
            item?.Quantity,
            item?.GetCurrentDurability(),
            IsSelected,
            IsHovered
        );
    }
}
