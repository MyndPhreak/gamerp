@using Sandbox;
@using Sandbox.UI;
@using System;

@namespace GameRP.UI
@inherits PanelComponent

<root class="orbit-overlay @(_isDragging ? "is-dragging" : "")">
</root>

@code {
    public bool IsActive { get; set; }
    public Action<float, float> OnOrbitDelta { get; set; }
    public Action<float> OnScrollZoom { get; set; }
    public Action<float> OnHeightDelta { get; set; }

    private bool _isDragging;
    private Vector2 _lastMousePos;
    private bool _isHeightDragging;
    private float _lastHeightY;

    protected override void OnUpdate()
    {
        if ( !IsActive ) return;

        // Scroll zoom
        var wheel = Input.MouseWheel.y;
        if ( MathF.Abs( wheel ) > 0.001f )
            OnScrollZoom?.Invoke( wheel );

        // Right-click orbit
        if ( Input.Pressed( "attack2" ) )
        {
            _isDragging = true;
            _lastMousePos = Mouse.Position;
            StateHasChanged();
        }
        else if ( Input.Released( "attack2" ) )
        {
            _isDragging = false;
            StateHasChanged();
        }

        if ( _isDragging )
        {
            var current = Mouse.Position;
            var delta = current - _lastMousePos;
            _lastMousePos = current;
            if ( delta.LengthSquared > 0.001f )
                OnOrbitDelta?.Invoke( delta.x, delta.y );
        }

        // Middle-click drag — adjust camera height offset
        if ( Input.Pressed( "iv_zoom" ) )
        {
            _isHeightDragging = true;
            _lastHeightY = Mouse.Position.y;
        }
        else if ( Input.Released( "iv_zoom" ) )
        {
            _isHeightDragging = false;
        }

        if ( _isHeightDragging )
        {
            var currentY = Mouse.Position.y;
            var dy = currentY - _lastHeightY;
            _lastHeightY = currentY;
            if ( MathF.Abs( dy ) > 0.001f )
                OnHeightDelta?.Invoke( dy );
        }
    }
}
