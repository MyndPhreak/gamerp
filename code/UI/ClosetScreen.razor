@using Sandbox;
@using Sandbox.UI;
@using GameRP.Entities;
@using System;
@using System.Collections.Generic;
@using System.Linq;

@namespace GameRP.UI
@inherits PanelComponent

<root style="@RootStyle">
    @if (_isOpen)
    {
        <!-- Left panel: clothing UI -->
        <div style="position: absolute; left: 0; top: 0; width: 38%; height: 100%; background: linear-gradient(180deg, rgba(20,20,30,0.95) 0%, rgba(15,15,25,0.98) 100%); display: flex; flex-direction: column; padding: 24px; gap: 16px; pointer-events: all; overflow: hidden;">

            <!-- Header -->
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div style="font-size: 28px; font-weight: 700; color: white;">@(_wizardMode ? "Create Your Look" : "Closet")</div>
            </div>

            @if (_wizardMode)
            {
                <!-- Gender selector -->
                <div style="display: flex; flex-direction: column; gap: 6px;">
                    <div style="font-size: 12px; font-weight: 600; color: rgba(255,255,255,0.5); text-transform: uppercase; letter-spacing: 1px;">Gender</div>
                    <div style="display: flex; gap: 8px;">
                        @foreach (var g in _genderOptions)
                        {
                            var isActive = g == _selectedGender;
                            var gStyle = isActive
                                ? "flex: 1; padding: 10px; border-radius: 8px; cursor: pointer; font-size: 14px; font-weight: 600; color: white; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); text-align: center;"
                                : "flex: 1; padding: 10px; border-radius: 8px; cursor: pointer; font-size: 14px; font-weight: 500; color: rgba(255,255,255,0.6); background-color: rgba(255,255,255,0.08); text-align: center;";
                            <div style="@gStyle" @onclick="@(() => SelectGender(g))">@g</div>
                        }
                    </div>
                </div>

                <!-- Body sliders -->
                <div style="display: flex; flex-direction: column; gap: 10px;">
                    <div style="font-size: 12px; font-weight: 600; color: rgba(255,255,255,0.5); text-transform: uppercase; letter-spacing: 1px;">Body</div>

                    <div style="display: flex; flex-direction: column; gap: 4px;">
                        <div style="display: flex; justify-content: space-between; font-size: 13px; color: rgba(255,255,255,0.7);">
                            <span>Skin Tone</span>
                            <span>@(_previewSkinTone.ToString("F2"))</span>
                        </div>
                        <input type="range" min="0" max="1" step="0.01" value="@_previewSkinTone"
                               @oninput="@(e => OnSkinToneChanged(e))"
                               style="width: 100%; accent-color: #667eea;" />
                    </div>

                    <div style="display: flex; flex-direction: column; gap: 4px;">
                        <div style="display: flex; justify-content: space-between; font-size: 13px; color: rgba(255,255,255,0.7);">
                            <span>Height</span>
                            <span>@(_previewHeight.ToString("F2"))</span>
                        </div>
                        <input type="range" min="0" max="1" step="0.01" value="@_previewHeight"
                               @oninput="@(e => OnHeightChanged(e))"
                               style="width: 100%; accent-color: #667eea;" />
                    </div>

                    <div style="display: flex; flex-direction: column; gap: 4px;">
                        <div style="display: flex; justify-content: space-between; font-size: 13px; color: rgba(255,255,255,0.7);">
                            <span>Age</span>
                            <span>@(_previewAge.ToString("F2"))</span>
                        </div>
                        <input type="range" min="0" max="1" step="0.01" value="@_previewAge"
                               @oninput="@(e => OnAgeChanged(e))"
                               style="width: 100%; accent-color: #667eea;" />
                    </div>
                </div>
            }

            <!-- Category tabs -->
            <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                @foreach (var category in _categories)
                {
                    var isActive = category == _selectedCategory;
                    var tabStyle = isActive
                        ? "padding: 8px 14px; border-radius: 20px; cursor: pointer; font-size: 12px; font-weight: 600; color: white; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);"
                        : "padding: 8px 14px; border-radius: 20px; cursor: pointer; font-size: 12px; font-weight: 600; color: rgba(255,255,255,0.6); background-color: rgba(255,255,255,0.08);";
                    <div style="@tabStyle" @onclick="@(() => SelectCategory(category))">@category</div>
                }
            </div>

            <!-- Item grid -->
            <div style="flex: 1; overflow: scroll; display: flex; flex-wrap: wrap; gap: 8px; align-content: flex-start;">
                <!-- "None" option to unequip -->
                @{
                    var noneActive = !_previewClothing.ContainsKey(_selectedCategory);
                    var noneStyle = noneActive
                        ? "width: calc(50% - 4px); padding: 12px; border-radius: 10px; cursor: pointer; font-size: 13px; font-weight: 600; color: white; background-color: rgba(102,126,234,0.3); border: 2px solid #667eea; text-align: center;"
                        : "width: calc(50% - 4px); padding: 12px; border-radius: 10px; cursor: pointer; font-size: 13px; font-weight: 500; color: rgba(255,255,255,0.7); background-color: rgba(255,255,255,0.05); border: 2px solid transparent; text-align: center;";
                }
                <div style="@noneStyle" @onclick="@(() => PreviewItem(null))">None</div>

                @foreach (var item in GetItemsForCategory())
                {
                    var isEquipped = _previewClothing.ContainsKey(_selectedCategory) && _previewClothing[_selectedCategory] == item.ResourcePath;
                    var itemStyle = isEquipped
                        ? "width: calc(50% - 4px); padding: 12px; border-radius: 10px; cursor: pointer; font-size: 13px; font-weight: 600; color: white; background-color: rgba(102,126,234,0.3); border: 2px solid #667eea; text-align: center; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;"
                        : "width: calc(50% - 4px); padding: 12px; border-radius: 10px; cursor: pointer; font-size: 13px; font-weight: 500; color: rgba(255,255,255,0.7); background-color: rgba(255,255,255,0.05); border: 2px solid transparent; text-align: center; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;";
                    <div style="@itemStyle" @onclick="@(() => PreviewItem(item.ResourcePath))">@item.Title</div>
                }
            </div>

            <!-- Action buttons -->
            <div style="display: flex; gap: 12px;">
                @if (_wizardMode)
                {
                    <div style="flex: 1; padding: 16px; border-radius: 12px; cursor: pointer; font-size: 16px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: white; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); text-align: center;" @onclick="@OnNextClicked">Next</div>
                }
                else if (!_showConfirmClose)
                {
                    <div style="flex: 1; padding: 16px; border-radius: 12px; cursor: pointer; font-size: 16px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: white; background-color: rgba(255,255,255,0.1); border: 2px solid rgba(255,255,255,0.2); text-align: center;" @onclick="@OnCloseClicked">Close</div>
                    @if (HasUnsavedChanges)
                    {
                        <div style="flex: 1; padding: 16px; border-radius: 12px; cursor: pointer; font-size: 16px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: white; background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%); text-align: center;" @onclick="@ApplyChanges">Apply</div>
                    }
                }
                else
                {
                    <!-- Unsaved changes confirmation -->
                    <div style="flex: 1; display: flex; flex-direction: column; gap: 12px;">
                        <div style="font-size: 14px; font-weight: 600; color: #f44336; text-align: center;">Your changes will not be saved. Are you sure?</div>
                        <div style="display: flex; gap: 12px;">
                            <div style="flex: 1; padding: 14px; border-radius: 8px; cursor: pointer; font-size: 14px; font-weight: 700; color: white; background-color: rgba(255,255,255,0.1); border: 2px solid rgba(255,255,255,0.2); text-align: center;" @onclick="@CancelClose">No</div>
                            <div style="flex: 1; padding: 14px; border-radius: 8px; cursor: pointer; font-size: 14px; font-weight: 700; color: white; background: linear-gradient(135deg, #f44336 0%, #d32f2f 100%); text-align: center;" @onclick="@ConfirmClose">Yes</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</root>

@code
{
    private bool _isOpen;
    private bool _wizardMode;
    private RPPlayer _rpPlayer;
    private GameRP.Entities.Closet _closet;
    private string _selectedCategory = "Hat";
    private bool _showConfirmClose;

    // Gender
    private readonly string[] _genderOptions = new[] { "Male", "Female", "Other" };
    private string _selectedGender = "Male";

    // Body params
    private float _previewSkinTone = 0.5f;
    private float _previewHeight = 0.5f;
    private float _previewAge = 0.5f;
    private float _originalSkinTone = 0.5f;
    private float _originalHeight = 0.5f;
    private float _originalAge = 0.5f;
    private string _originalGender = "Male";

    // All clothing categories
    private readonly string[] _categories = new[]
    {
        "Hat", "Hair", "Facial", "Shirt", "Gloves", "Pants", "Shoes", "Skin"
    };

    // Maps category -> resource path of equipped item
    private Dictionary<string, string> _originalClothing = new();
    private Dictionary<string, string> _previewClothing = new();

    // All available clothing items cached on open
    private List<Sandbox.Clothing> _allClothing = new();

    // Callbacks for wizard mode
    public Action<string, float, float, float, Dictionary<string, string>> OnWizardNext { get; set; }

    private string RootStyle => "position: absolute; left: 0; top: 0; width: 100%; height: 100%; z-index: 100; pointer-events: none;";

    private bool HasUnsavedChanges =>
        !DictionariesEqual( _originalClothing, _previewClothing ) ||
        MathF.Abs( _previewSkinTone - _originalSkinTone ) >= 0.001f ||
        MathF.Abs( _previewHeight - _originalHeight ) >= 0.001f ||
        MathF.Abs( _previewAge - _originalAge ) >= 0.001f ||
        _selectedGender != _originalGender;

    /// <summary>
    /// Open in standalone mode (from in-world closet entity)
    /// </summary>
    public void Open( RPPlayer rpPlayer, GameRP.Entities.Closet closet )
    {
        OpenInternal( rpPlayer, false );
        _closet = closet;
    }

    /// <summary>
    /// Open in wizard mode (from character creation)
    /// </summary>
    public void OpenWizard( RPPlayer rpPlayer )
    {
        OpenInternal( rpPlayer, true );
    }

    private void OpenInternal( RPPlayer rpPlayer, bool wizardMode )
    {
        if ( _isOpen ) return;

        _rpPlayer = rpPlayer;
        _wizardMode = wizardMode;
        _isOpen = true;
        _showConfirmClose = false;
        _selectedCategory = "Hat";
        _closet = null;

        // Cache all available clothing
        _allClothing = ResourceLibrary.GetAll<Sandbox.Clothing>().ToList();
        Log.Info( $"[ClosetScreen] Loaded {_allClothing.Count} clothing items" );

        // Snapshot current clothing as original
        _originalClothing = BuildClothingMap( rpPlayer.EquippedClothing );
        _previewClothing = new Dictionary<string, string>( _originalClothing );

        // Load body params
        _selectedGender = rpPlayer.Gender;
        _previewSkinTone = rpPlayer.SkinTone;
        _previewHeight = rpPlayer.Height;
        _previewAge = rpPlayer.Age;

        _originalSkinTone = _previewSkinTone;
        _originalHeight = _previewHeight;
        _originalAge = _previewAge;
        _originalGender = _selectedGender;

        StateHasChanged();
    }

    private Dictionary<string, string> BuildClothingMap( List<string> paths )
    {
        var map = new Dictionary<string, string>();
        foreach ( var path in paths )
        {
            var item = ResourceLibrary.Get<Sandbox.Clothing>( path );
            if ( item != null )
            {
                map[item.Category.ToString()] = path;
            }
        }
        return map;
    }

    private void SelectCategory( string category )
    {
        _selectedCategory = category;
        _showConfirmClose = false;
        StateHasChanged();
    }

    private void SelectGender( string gender )
    {
        _selectedGender = gender;
        StateHasChanged();
    }

    private List<Sandbox.Clothing> GetItemsForCategory()
    {
        return _allClothing
            .Where( c => c.Category.ToString() == _selectedCategory )
            .OrderBy( c => c.Title )
            .ToList();
    }

    private void PreviewItem( string resourcePath )
    {
        _showConfirmClose = false;

        if ( resourcePath == null )
        {
            _previewClothing.Remove( _selectedCategory );
        }
        else
        {
            _previewClothing[_selectedCategory] = resourcePath;
        }

        ApplyPreviewToDresser();
        StateHasChanged();
    }

    private void OnSkinToneChanged( PanelEvent e )
    {
        if ( float.TryParse( e.Value?.ToString(), out var val ) )
        {
            _previewSkinTone = val;
            ApplyBodyToDresser();
        }
    }

    private void OnHeightChanged( PanelEvent e )
    {
        if ( float.TryParse( e.Value?.ToString(), out var val ) )
        {
            _previewHeight = val;
            ApplyBodyToDresser();
        }
    }

    private void OnAgeChanged( PanelEvent e )
    {
        if ( float.TryParse( e.Value?.ToString(), out var val ) )
        {
            _previewAge = val;
            ApplyBodyToDresser();
        }
    }

    private void ApplyBodyToDresser()
    {
        if ( _rpPlayer == null ) return;

        var dresser = _rpPlayer.Components.Get<Dresser>();
        if ( dresser == null ) return;

        dresser.ManualTint = _previewSkinTone;
        dresser.ManualHeight = _previewHeight;
        dresser.ManualAge = _previewAge;
        dresser.Apply();
    }

    private void ApplyPreviewToDresser()
    {
        if ( _rpPlayer == null ) return;

        var paths = _previewClothing.Values.ToList();
        var dresser = _rpPlayer.Components.Get<Dresser>();
        if ( dresser == null ) return;

        var entries = new List<Sandbox.ClothingContainer.ClothingEntry>();
        foreach ( var path in paths )
        {
            var item = ResourceLibrary.Get<Sandbox.Clothing>( path );
            if ( item != null )
                entries.Add( new Sandbox.ClothingContainer.ClothingEntry { Clothing = item } );
        }

        dresser.Clothing = entries;
        dresser.Apply();
    }

    private void OnNextClicked()
    {
        // Pass wizard data to the callback
        OnWizardNext?.Invoke( _selectedGender, _previewSkinTone, _previewHeight, _previewAge, new Dictionary<string, string>( _previewClothing ) );

        _isOpen = false;
        StateHasChanged();
    }

    private void ApplyChanges()
    {
        if ( _rpPlayer == null ) return;

        _rpPlayer.EquippedClothing = _previewClothing.Values.ToList();
        _rpPlayer.ApplyClothingToDresser();
        _rpPlayer.SkinTone = _previewSkinTone;
        _rpPlayer.Height = _previewHeight;
        _rpPlayer.Age = _previewAge;
        _rpPlayer.ApplyBodyToDresser();

        _originalClothing = new Dictionary<string, string>( _previewClothing );

        StateHasChanged();
    }

    private void OnCloseClicked()
    {
        if ( HasUnsavedChanges )
        {
            _showConfirmClose = true;
            StateHasChanged();
            return;
        }

        DoClose();
    }

    private void CancelClose()
    {
        _showConfirmClose = false;
        StateHasChanged();
    }

    private void ConfirmClose()
    {
        _previewClothing = new Dictionary<string, string>( _originalClothing );
        ApplyPreviewToDresser();
        _rpPlayer.EquippedClothing = _originalClothing.Values.ToList();

        _previewSkinTone = _originalSkinTone;
        _previewHeight = _originalHeight;
        _previewAge = _originalAge;
        _selectedGender = _originalGender;
        ApplyBodyToDresser();

        DoClose();
    }

    private void DoClose()
    {
        _isOpen = false;
        _showConfirmClose = false;
        _closet?.Close();
        StateHasChanged();
    }

    public void CloseWizard()
    {
        _isOpen = false;
        StateHasChanged();
    }

    /// <summary>
    /// Re-open the closet in wizard mode with preserved state (when user clicks "Back" on the license)
    /// </summary>
    public void ReopenWizard()
    {
        _isOpen = true;
        _wizardMode = true;
        StateHasChanged();
    }

    private static bool DictionariesEqual( Dictionary<string, string> a, Dictionary<string, string> b )
    {
        if ( a.Count != b.Count ) return false;
        foreach ( var kvp in a )
        {
            if ( !b.TryGetValue( kvp.Key, out var val ) || val != kvp.Value )
                return false;
        }
        return true;
    }

    protected override int BuildHash() => System.HashCode.Combine(
        System.HashCode.Combine( _isOpen, _selectedCategory, _showConfirmClose, _wizardMode ),
        System.HashCode.Combine( _previewClothing.Count, HasUnsavedChanges ),
        System.HashCode.Combine( _selectedGender,
            _previewSkinTone.GetHashCode(),
            _previewHeight.GetHashCode(),
            _previewAge.GetHashCode() )
    );
}
