@using Sandbox;
@using Sandbox.UI;
@using GameRP.Entities;
@using System;
@using System.Collections.Generic;
@using System.Linq;

@namespace GameRP.UI
@inherits PanelComponent

<root>
    @if (_isOpen)
    {
        <div class="closet-panel">

            <!-- Header -->
            <div class="closet-header">
                <div class="closet-title">@(_wizardMode ? "Create Your Look" : "Closet")</div>
            </div>

            @if (_wizardMode)
            {
                <!-- Gender selector -->
                <div class="wizard-section">
                    <div class="section-label">Gender</div>
                    <div class="gender-buttons">
                        @foreach (var g in _genderOptions)
                        {
                            var isActive = g == _selectedGender;
                            <div class="gender-btn @(isActive ? "active" : "")" @onclick="@(() => SelectGender(g))">@g</div>
                        }
                    </div>
                </div>

                <!-- Body sliders -->
                <div class="wizard-section">
                    <div class="section-label">Body</div>
                    <div class="body-sliders">
                        <div class="slider-row">
                            <div class="slider-label"><span>Skin Tone</span><span>@(_previewSkinTone.ToString("F2"))</span></div>
                            <input type="range" min="0" max="1" step="0.01" value="@_previewSkinTone" @oninput="@(e => OnSkinToneChanged(e))" />
                        </div>
                        <div class="slider-row">
                            <div class="slider-label"><span>Height</span><span>@(_previewHeight.ToString("F2"))</span></div>
                            <input type="range" min="0" max="1" step="0.01" value="@_previewHeight" @oninput="@(e => OnHeightChanged(e))" />
                        </div>
                        <div class="slider-row">
                            <div class="slider-label"><span>Age</span><span>@(_previewAge.ToString("F2"))</span></div>
                            <input type="range" min="0" max="1" step="0.01" value="@_previewAge" @oninput="@(e => OnAgeChanged(e))" />
                        </div>
                    </div>
                </div>
            }

            <!-- Character preview -->
            <div class="item-preview">
                <ScenePanel @ref="_previewPanel" class="preview-scene" />
            </div>

            <!-- Main category icon tabs -->
            <div class="main-category-tabs">
                @foreach (var main in _activeMainCategories)
                {
                    var isMainActive = main == _selectedMainCategory;
                    <div class="main-cat-btn @(isMainActive ? "active" : "")" @onclick="@(() => SelectMainCategory(main))">
                        <div class="main-cat-icon">@GetMainCategoryIcon(main)</div>
                        <div class="main-cat-label">@main</div>
                    </div>
                }
            </div>

            <!-- Sub-category pill tabs (hidden when only one sub exists) -->
            @if (_subCategoriesForMain.Length > 1)
            {
                <div class="category-tabs">
                    @foreach (var sub in _subCategoriesForMain)
                    {
                        var isSubActive = sub == _selectedCategory;
                        <div class="pill-tab @(isSubActive ? "active" : "")" @onclick="@(() => SelectCategory(sub))">@sub</div>
                    }
                </div>
            }

            <!-- Item grid -->
            <div class="item-grid">
                @{
                    var noneSelected = !_previewClothing.ContainsKey(_selectedCategory);
                }
                <div class="item-card--none @(noneSelected ? "selected" : "")" @onclick="@(() => PreviewItem(null))">
                    ✕
                    <div class="card-name">None</div>
                </div>

                @foreach (var item in GetItemsForCategory())
                {
                    var isEquipped = _previewClothing.ContainsKey(_selectedCategory) && _previewClothing[_selectedCategory] == item.ResourcePath;
                    <div class="item-card @(isEquipped ? "selected" : "")" style="background-image: url(@item.ResourcePath)" @onclick="@(() => PreviewItem(item.ResourcePath))">
                        <div class="card-name">@item.Title</div>
                    </div>
                }
            </div>

            <!-- Action buttons -->
            <div class="action-row">
                @if (_wizardMode)
                {
                    <div class="btn-primary" @onclick="@OnNextClicked">Next</div>
                }
                else if (!_showConfirmClose)
                {
                    <div class="btn-secondary" @onclick="@OnCloseClicked">Close</div>
                    @if (HasUnsavedChanges)
                    {
                        <div class="btn-success" @onclick="@ApplyChanges">Apply</div>
                    }
                }
                else
                {
                    <!-- Unsaved changes confirmation -->
                    <div class="confirm-close">
                        <div class="confirm-message">Your changes will not be saved. Are you sure?</div>
                        <div class="confirm-buttons">
                            <div class="btn-secondary" @onclick="@CancelClose">No</div>
                            <div class="btn-danger" @onclick="@ConfirmClose">Yes</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</root>

@code
{
    private bool _isOpen;
    private bool _wizardMode;
    private RPPlayer _rpPlayer;
    private GameRP.Entities.Closet _closet;
    private string _selectedCategory = string.Empty;
    private bool _showConfirmClose;

    // 3D preview scene
    private ScenePanel _previewPanel;
    private SceneWorld _previewWorld;
    private SceneModel _baseModel;
    private List<SceneModel> _clothingModels = new();

    // Gender
    private readonly string[] _genderOptions = new[] { "Male", "Female", "Other" };
    private string _selectedGender = "Male";

    // Body params
    private float _previewSkinTone = 0.5f;
    private float _previewHeight = 0.5f;
    private float _previewAge = 0.5f;
    private float _originalSkinTone = 0.5f;
    private float _originalHeight = 0.5f;
    private float _originalAge = 0.5f;
    private string _originalGender = "Male";

    // Raw clothing categories derived at open-time from ResourceLibrary.
    private string[] _categories = Array.Empty<string>();

    // Two-tier category navigation
    private string[] _activeMainCategories = Array.Empty<string>();
    private string _selectedMainCategory = string.Empty;
    private string[] _subCategoriesForMain = Array.Empty<string>();

    // Main category → (emoji icon, sub-category names)
    private static readonly Dictionary<string, (string Icon, string[] Subs)> _mainCategoryDefs = new()
    {
        ["Tops"]         = ("👕", new[] { "Shirt", "TShirt", "Tops", "Knitwear", "Hoodie", "Vest" }),
        ["Outerwear"]    = ("🧥", new[] { "Jacket", "Cardigan", "Gilet", "Coat" }),
        ["Bottoms"]      = ("👖", new[] { "Jeans", "Trousers", "Shorts", "Skirt" }),
        ["Full Outfits"] = ("👗", new[] { "Dress", "Suit", "Costume" }),
        ["Underwear"]    = ("🩲", new[] { "Underwear", "Bra" }),
        ["Footwear"]     = ("👟", new[] { "Boots", "Shoes", "Footwear", "Heels", "Slippers", "Trainers" }),
        ["Headwear"]     = ("🎩", new[] { "Hat", "HatBeanie", "HatCostume", "HatFormal", "Hatuniform" }),
        ["Hair"]         = ("💇", new[] { "Hair", "HairShort", "HairMedium", "HairLong", "HairlJpdo" }),
        ["Facial Hair"]  = ("🧔", new[] { "FacialHairBeard", "FacialHairGoatee", "FacialHairMustache", "FacialHairSideburns" }),
        ["Makeup"]       = ("💄", new[] { "Eyebrows", "Eyelashes", "MakeupEyeshadow", "MakeupLips", "MakeupSpecial" }),
        ["Skin"]         = ("🎨", new[] { "Skin", "ComplexionFreckles", "ComplexionScars" }),
        ["Accessories"]  = ("💎", new[] { "GlassesEye", "GlassesSun", "Gloves", "NecklacePendant", "Wristwatch" }),
        ["Head Special"] = ("🥽", new[] { "HeadTech", "HeadSpecial" }),
    };

    // Maps category -> resource path of equipped item
    private Dictionary<string, string> _originalClothing = new();
    private Dictionary<string, string> _previewClothing = new();

    // All available clothing items cached on open
    private List<Sandbox.Clothing> _allClothing = new();

    // Callbacks for wizard mode
    public Action<string, float, float, float, Dictionary<string, string>> OnWizardNext { get; set; }

    private bool HasUnsavedChanges =>
        !DictionariesEqual( _originalClothing, _previewClothing ) ||
        MathF.Abs( _previewSkinTone - _originalSkinTone ) >= 0.001f ||
        MathF.Abs( _previewHeight - _originalHeight ) >= 0.001f ||
        MathF.Abs( _previewAge - _originalAge ) >= 0.001f ||
        _selectedGender != _originalGender;

    /// <summary>
    /// Open in standalone mode (from in-world closet entity)
    /// </summary>
    public void Open( RPPlayer rpPlayer, GameRP.Entities.Closet closet )
    {
        OpenInternal( rpPlayer, false );
        _closet = closet;
    }

    /// <summary>
    /// Open in wizard mode (from character creation)
    /// </summary>
    public void OpenWizard( RPPlayer rpPlayer )
    {
        OpenInternal( rpPlayer, true );
    }

    private void OpenInternal( RPPlayer rpPlayer, bool wizardMode )
    {
        if ( _isOpen ) return;

        _rpPlayer = rpPlayer;
        _wizardMode = wizardMode;
        _isOpen = true;
        _showConfirmClose = false;
        _closet = null;

        // Cache all available clothing
        _allClothing = ResourceLibrary.GetAll<Sandbox.Clothing>().ToList();

        // Derive raw categories from available items
        _categories = _allClothing
            .Select( c => c.Category.ToString() )
            .Distinct()
            .OrderBy( s => s )
            .ToArray();

        // Build two-tier navigation: only show main groups that have at least one available sub
        var allMappedSubs = _mainCategoryDefs.Values.SelectMany( d => d.Subs ).ToHashSet();
        var hasOther = _categories.Any( c => !allMappedSubs.Contains( c ) );

        _activeMainCategories = _mainCategoryDefs.Keys
            .Where( main => _mainCategoryDefs[main].Subs.Any( s => _categories.Contains( s ) ) )
            .Concat( hasOther ? new[] { "Other" } : Array.Empty<string>() )
            .ToArray();

        _selectedMainCategory = _activeMainCategories.Length > 0 ? _activeMainCategories[0] : string.Empty;
        _subCategoriesForMain = _selectedMainCategory != string.Empty ? GetSubCategoriesForMain( _selectedMainCategory ) : Array.Empty<string>();
        _selectedCategory = _subCategoriesForMain.Length > 0 ? _subCategoriesForMain[0] : string.Empty;

        // Snapshot current clothing as original
        _originalClothing = BuildClothingMap( rpPlayer.EquippedClothing );
        _previewClothing = new Dictionary<string, string>( _originalClothing );

        // Load body params
        _selectedGender = rpPlayer.Gender;
        _previewSkinTone = rpPlayer.SkinTone;
        _previewHeight = rpPlayer.Height;
        _previewAge = rpPlayer.Age;

        _originalSkinTone = _previewSkinTone;
        _originalHeight = _previewHeight;
        _originalAge = _previewAge;
        _originalGender = _selectedGender;

        StateHasChanged();
    }

    private Dictionary<string, string> BuildClothingMap( List<string> paths )
    {
        var map = new Dictionary<string, string>();
        foreach ( var path in paths )
        {
            var item = ResourceLibrary.Get<Sandbox.Clothing>( path );
            if ( item != null )
            {
                map[item.Category.ToString()] = path;
            }
        }
        return map;
    }

    private void SelectMainCategory( string main )
    {
        _selectedMainCategory = main;
        _subCategoriesForMain = GetSubCategoriesForMain( main );
        _selectedCategory = _subCategoriesForMain.Length > 0 ? _subCategoriesForMain[0] : string.Empty;
        _showConfirmClose = false;
        StateHasChanged();
    }

    private string[] GetSubCategoriesForMain( string main )
    {
        if ( !_mainCategoryDefs.TryGetValue( main, out var def ) )
        {
            // "Other" bucket — categories not covered by any main group
            var allMapped = _mainCategoryDefs.Values.SelectMany( d => d.Subs ).ToHashSet();
            return _categories.Where( c => !allMapped.Contains( c ) ).OrderBy( s => s ).ToArray();
        }
        return def.Subs.Where( s => _categories.Contains( s ) ).OrderBy( s => s ).ToArray();
    }

    private string GetMainCategoryIcon( string main ) =>
        _mainCategoryDefs.TryGetValue( main, out var def ) ? def.Icon : "?";

    private void SelectCategory( string category )
    {
        _selectedCategory = category;
        _showConfirmClose = false;
        StateHasChanged();
    }

    private void SelectGender( string gender )
    {
        _selectedGender = gender;
        StateHasChanged();
    }

    private List<Sandbox.Clothing> GetItemsForCategory()
    {
        return _allClothing
            .Where( c => c.Category.ToString() == _selectedCategory )
            .OrderBy( c => c.Title )
            .ToList();
    }

    private void PreviewItem( string resourcePath )
    {
        _showConfirmClose = false;

        if ( resourcePath == null )
        {
            _previewClothing.Remove( _selectedCategory );
        }
        else
        {
            _previewClothing[_selectedCategory] = resourcePath;
        }

        ApplyPreviewToDresser();
        UpdatePlayerPreview();
        StateHasChanged();
    }

    private void EnsurePreviewScene()
    {
        if ( _previewWorld != null || _previewPanel == null ) return;

        _previewWorld = new SceneWorld();

        // Key light from front-left, fill from right
        new ScenePointLight( _previewWorld, new Vector3( -60, 120, 150 ), 600, Color.White );
        new ScenePointLight( _previewWorld, new Vector3( 80, 60, 80 ), 300, Color.White * 0.4f );

        // Framed for full-body: character is ~72 units tall, camera looks at torso height
        _ = new SceneCamera
        {
            World = _previewWorld,
            Position = new Vector3( 0, 160, 55 ),
            Angles = new Angles( 8, 180, 0 ),
            FieldOfView = 30,
            ZNear = 1,
            ZFar = 1000
        };

        _previewPanel.World = _previewWorld;
    }

    /// <summary>
    /// Rebuild the character mannequin in the preview scene using the current preview clothing.
    /// Creates a base body model at the origin then overlays each equipped clothing item.
    /// All models share T-pose at default transform, so clothing designed for the citizen
    /// skeleton aligns correctly without requiring explicit bone merging.
    /// </summary>
    private void UpdatePlayerPreview()
    {
        EnsurePreviewScene();
        if ( _previewWorld == null || _rpPlayer == null ) return;

        // Tear down previous models
        _baseModel?.Delete();
        _baseModel = null;
        foreach ( var m in _clothingModels ) m?.Delete();
        _clothingModels.Clear();

        // Use the player's actual body model so the preview matches their character
        var renderer = _rpPlayer.Components.Get<SkinnedModelRenderer>();
        var bodyPath = renderer?.Model?.ResourcePath ?? "models/citizen/citizen.vmdl";

        // Rotate 180° so the character faces toward the camera
        var facingCamera = new Transform( Vector3.Zero, Rotation.FromYaw( 180 ) );

        _baseModel = new SceneModel( _previewWorld, bodyPath, facingCamera );

        // Overlay each equipped clothing item at the same transform (T-pose alignment)
        foreach ( var path in _previewClothing.Values )
        {
            var clothing = ResourceLibrary.Get<Sandbox.Clothing>( path );
            if ( clothing == null || string.IsNullOrEmpty( clothing.Model ) ) continue;

            _clothingModels.Add( new SceneModel( _previewWorld, clothing.Model, facingCamera ) );
        }
    }

    private void OnSkinToneChanged( PanelEvent e )
    {
        if ( float.TryParse( e.Value?.ToString(), out var val ) )
        {
            _previewSkinTone = val;
            ApplyBodyToDresser();
        }
    }

    private void OnHeightChanged( PanelEvent e )
    {
        if ( float.TryParse( e.Value?.ToString(), out var val ) )
        {
            _previewHeight = val;
            ApplyBodyToDresser();
        }
    }

    private void OnAgeChanged( PanelEvent e )
    {
        if ( float.TryParse( e.Value?.ToString(), out var val ) )
        {
            _previewAge = val;
            ApplyBodyToDresser();
        }
    }

    private void ApplyBodyToDresser()
    {
        if ( _rpPlayer == null ) return;

        var dresser = _rpPlayer.Components.Get<Dresser>();
        if ( dresser == null ) return;

        dresser.ManualTint = _previewSkinTone;
        dresser.ManualHeight = _previewHeight;
        dresser.ManualAge = _previewAge;
        dresser.Apply();
    }

    private void ApplyPreviewToDresser()
    {
        if ( _rpPlayer == null ) return;

        var paths = _previewClothing.Values.ToList();
        var dresser = _rpPlayer.Components.Get<Dresser>();
        if ( dresser == null ) return;

        var entries = new List<Sandbox.ClothingContainer.ClothingEntry>();
        foreach ( var path in paths )
        {
            var item = ResourceLibrary.Get<Sandbox.Clothing>( path );
            if ( item != null )
                entries.Add( new Sandbox.ClothingContainer.ClothingEntry { Clothing = item } );
        }

        dresser.Clothing = entries;
        dresser.Apply();
    }

    private void OnNextClicked()
    {
        // Pass wizard data to the callback
        OnWizardNext?.Invoke( _selectedGender, _previewSkinTone, _previewHeight, _previewAge, new Dictionary<string, string>( _previewClothing ) );

        _isOpen = false;
        StateHasChanged();
    }

    private void ApplyChanges()
    {
        if ( _rpPlayer == null ) return;

        _rpPlayer.EquippedClothing = _previewClothing.Values.ToList();
        _rpPlayer.ApplyClothingToDresser();
        _rpPlayer.SkinTone = _previewSkinTone;
        _rpPlayer.Height = _previewHeight;
        _rpPlayer.Age = _previewAge;
        _rpPlayer.ApplyBodyToDresser();

        _originalClothing = new Dictionary<string, string>( _previewClothing );

        StateHasChanged();
    }

    private void OnCloseClicked()
    {
        if ( HasUnsavedChanges )
        {
            _showConfirmClose = true;
            StateHasChanged();
            return;
        }

        DoClose();
    }

    private void CancelClose()
    {
        _showConfirmClose = false;
        StateHasChanged();
    }

    private void ConfirmClose()
    {
        _previewClothing = new Dictionary<string, string>( _originalClothing );
        ApplyPreviewToDresser();
        _rpPlayer.EquippedClothing = _originalClothing.Values.ToList();

        _previewSkinTone = _originalSkinTone;
        _previewHeight = _originalHeight;
        _previewAge = _originalAge;
        _selectedGender = _originalGender;
        ApplyBodyToDresser();

        DoClose();
    }

    private void DoClose()
    {
        // Clean up 3D preview scene
        _baseModel?.Delete();
        _baseModel = null;
        foreach ( var m in _clothingModels ) m?.Delete();
        _clothingModels.Clear();
        _previewWorld?.Delete();
        _previewWorld = null;

        _isOpen = false;
        _showConfirmClose = false;
        _closet?.Close();
        StateHasChanged();
    }

    public void CloseWizard()
    {
        _isOpen = false;
        StateHasChanged();
    }

    /// <summary>
    /// Re-open the closet in wizard mode with preserved state (when user clicks "Back" on the license)
    /// </summary>
    public void ReopenWizard()
    {
        _isOpen = true;
        _wizardMode = true;
        StateHasChanged();
    }

    // Initialize the preview scene after the tree is first built (panel ref isn't ready until after render)
    protected override void OnTreeFirstBuilt()
    {
        base.OnTreeFirstBuilt();
        if ( _isOpen && _previewPanel != null && _previewWorld == null )
            UpdatePlayerPreview();
    }

    private static bool DictionariesEqual( Dictionary<string, string> a, Dictionary<string, string> b )
    {
        if ( a.Count != b.Count ) return false;
        foreach ( var kvp in a )
        {
            if ( !b.TryGetValue( kvp.Key, out var val ) || val != kvp.Value )
                return false;
        }
        return true;
    }

    protected override int BuildHash() => System.HashCode.Combine(
        System.HashCode.Combine( _isOpen, _selectedMainCategory, _selectedCategory, _showConfirmClose ),
        System.HashCode.Combine( _wizardMode, _previewClothing.Count, HasUnsavedChanges ),
        System.HashCode.Combine( _selectedGender,
            _previewSkinTone.GetHashCode(),
            _previewHeight.GetHashCode(),
            _previewAge.GetHashCode() )
    );
}
